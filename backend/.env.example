DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qa_assistant?schema=public"
JWT_SECRET="cambia-este-secreto-en-produccion"
JWT_EXPIRES_IN="8h"
PORT=3000

# LLM_PROVIDER=mock usa respuestas simuladas (no requiere clave de API).
# Para conectar un proveedor real mas adelante, implementa la interfaz LlmProvider
# (ver src/llm-gateway) y cambia este valor, por ejemplo a "openai" u "anthropic".
LLM_PROVIDER="mock"
# LLM_API_KEY="tu-clave-aqui"
